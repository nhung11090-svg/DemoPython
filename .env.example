# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# TEACHER_USERNAME: Username for teacher area login (e.g., giaovien). Defaults to "giaovien" if not specified.
TEACHER_USERNAME=

# TEACHER_PASSWORD: Secure password for teacher authentication. Defaults to "giaovien2026" if not specified.
TEACHER_PASSWORD=

# TEACHER_SESSION_SECRET: Secret encryption key for teacher session token verification.
TEACHER_SESSION_SECRET=

# GOOGLE_SHEETS_WEBHOOK_URL: Google Apps Script Web App URL (Deploy -> Web App -> Anyone) for single-source student data pipeline
GOOGLE_SHEETS_WEBHOOK_URL=

# GOOGLE_SHEET_MACRO_URL: Alias for GOOGLE_SHEETS_WEBHOOK_URL
GOOGLE_SHEET_MACRO_URL=

# GOOGLE_SHEETS_WEBHOOK_SECRET: Optional security secret for webhook verification
GOOGLE_SHEETS_WEBHOOK_SECRET=

# GOOGLE_SHEET_URL: Direct URL to Google Spreadsheet (e.g., https://docs.google.com/spreadsheets/d/.../edit) for teacher quick access
GOOGLE_SHEET_URL=
