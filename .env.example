# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TEACHER_PASSWORD: Password for teacher area access (/teacher, /teacher/login, /teacher/questions)
TEACHER_PASSWORD="giaovien2026"

# GOOGLE_SHEET_MACRO_URL: Google Apps Script Web App URL for logging student scores
GOOGLE_SHEET_MACRO_URL="https://script.google.com/macros/s/.../exec"
